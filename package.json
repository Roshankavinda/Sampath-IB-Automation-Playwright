{
  "name": "sampath-ib-automation",
  "version": "1.0.0",
  "description": "Playwright POM automation for Sampath Vishwa Retail Web - Login, Fund Transfer (Own/Other Bank) and Bill Payment",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:positive": "playwright test tests/positive --headed",
    "test:negative": "playwright test tests/negative --headed",
    "test:regression": "SUITE=regression playwright test --headed",
    "test:regression:positive": "SUITE=regression playwright test tests/positive/regression.spec.js --headed",
    "test:regression:negative": "SUITE=regression playwright test tests/negative/regression.spec.js --headed",
    "test:login": "playwright test tests/*/login.spec.js --headed",
    "test:forgot": "playwright test tests/*/forgotPassword.spec.js --headed",
    "test:dashboard": "playwright test tests/*/dashboard.spec.js --headed",
    "test:own": "playwright test tests/*/fundTransferOwnAccount.spec.js --headed",
    "test:intra": "playwright test tests/*/fundTransferIntraBank.spec.js --headed",
    "test:otherbank": "playwright test tests/*/fundTransferOtherBank.spec.js --headed",
    "test:mobilecash": "playwright test tests/*/fundTransferMobileCash.spec.js --headed",
    "test:cards": "playwright test tests/*/fundTransferOtherCreditCard.spec.js --headed",
    "test:cardsettlement": "playwright test tests/*/ownCardSettlement.spec.js --headed",
    "test:stopcard": "playwright test tests/*/stopCard.spec.js --headed",
    "test:billpay": "playwright test tests/*/billPayment.spec.js --headed",
    "test:payee": "playwright test tests/*/addPayee.spec.js --headed",
    "test:biller": "playwright test tests/*/addBiller.spec.js --headed",
    "test:savedpayee": "playwright test tests/*/transferSavedPayee.spec.js --headed",
    "test:savedbiller": "playwright test tests/*/billPaymentSavedBiller.spec.js --headed",
    "test:savedbillerlist": "playwright test tests/*/savedBillersList.spec.js --headed",
    "test:billhistory": "playwright test tests/*/billPaymentHistory.spec.js --headed",
    "test:billermaintenance": "playwright test tests/*/savedBillerMaintenance.spec.js --headed",
    "test:payeemaintenance": "playwright test tests/*/savedPayeeMaintenance.spec.js --headed",
    "test:sendmoneytabs": "playwright test tests/*/sendMoneyTabs.spec.js --headed",
    "test:messages": "playwright test tests/*/messages.spec.js --headed",
    "test:selfservice": "playwright test tests/*/selfServices.spec.js --headed",
    "test:slipless": "playwright test tests/*/slipless.spec.js --headed",
    "test:webcard": "playwright test tests/*/webCardOpening.spec.js --headed",
    "test:auto-otp": "IB_MANUAL_OTP=false playwright test",
    "report": "playwright show-report",
    "allure:serve": "allure serve allure-results",
    "allure:report": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:clean": "rm -rf allure-results allure-report",
    "test:allure": "npm run allure:clean && playwright test; npm run allure:serve"
  },
  "keywords": [
    "playwright",
    "pom",
    "automation",
    "sampath",
    "banking"
  ],
  "author": "Roshan Wickramasooriya",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^16.4.5"
  }
}
