{
  "name": "sampath-ib-automation",
  "version": "1.0.0",
  "description": "Playwright POM automation for Sampath Vishwa Retail Web - Login, Fund Transfer (Own/Other Bank) and Bill Payment",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:login": "playwright test tests/login.spec.js --headed",
    "test:own": "playwright test tests/ownFundTransfer.spec.js --headed",
    "test:otherbank": "playwright test tests/otherBankTransfer.spec.js --headed",
    "test:billpay": "playwright test tests/billPayment.spec.js --headed",
    "test:cards": "playwright test tests/otherCreditCards.spec.js --headed",
    "test:mobilecash": "playwright test tests/mobileCash.spec.js --headed",
    "test:payees": "playwright test tests/payeesBillers.spec.js --headed",
    "test:savedpayee": "playwright test tests/savedPayeesTransfer.spec.js --headed",
    "test:scheduled": "playwright test tests/scheduledTransfer.spec.js --headed",
    "test:fd": "playwright test tests/fixedDeposit.spec.js --headed",
    "test:stopcheque": "playwright test tests/stopCheque.spec.js --headed",
    "test:negative": "playwright test tests/negativeTransfers.spec.js --headed",
    "report": "playwright show-report"
  },
  "keywords": ["playwright", "pom", "automation", "sampath", "banking"],
  "author": "Roshan Wickramasooriya",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "dotenv": "^16.4.5"
  }
}
