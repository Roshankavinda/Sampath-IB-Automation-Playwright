BASE_URL=http://your-uat-host:4200/SVRClientWebV4/home
IB_USERNAME=your-username
IB_PASSWORD=your-password
IB_OTP=111111
# Optional: identifier some Forgot Password flows ask for (leave blank if not needed)
IB_NIC=

# ---- Timeouts (see config/timeouts.js) ----
# Scale EVERY wait at once for a slow environment, e.g. 1.5 = +50%. Default 1.
IB_TIMEOUT_SCALE=1
# How long the manual transaction/reset OTP pause waits (ms). Default 180000.
IB_MANUAL_OTP_TIMEOUT=180000
